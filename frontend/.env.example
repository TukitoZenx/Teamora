# Public backend origin used by the SPA (no trailing slash).
# Local: http://localhost:5000
# Production: must be set at build time (e.g. https://api.yourdomain.com)
VITE_API_URL=http://localhost:5000

# Optional Axios timeout in ms (default 30000)
# VITE_API_TIMEOUT_MS=30000

# Optional LAN HTTPS for camera/mic from another device (mkcert paths relative to frontend cwd).
# VITE_TLS_KEY_PATH=../backend/certs/teamora-lan-key.pem
# VITE_TLS_CERT_PATH=../backend/certs/teamora-lan.pem

# Optional WebRTC TURN/STUN for multi-network meetings (build-time).
# Backend TURN_* env on the collab server is preferred in production.
# VITE_TURN_URLS=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
# Aliases also accepted: VITE_TURN_USER / VITE_TURN_SECRET
# VITE_STUN_URLS=stun:stun.l.google.com:19302
