# runtime: development | production
NODE_ENV=production
# HTTP listen port
PORT=5000
# MongoDB connection string
MONGODB_URI=<mongodb-connection-string>
# Required in production — long random secret for express-session
SESSION_SECRET=<long-random-session-secret>
# Public frontend origin (password-reset links, OAuth redirects, invite links)
CLIENT_URL=<frontend-url>
# Optional public backend URL (OAuth callback absolute URLs, docs)
SERVER_URL=<backend-url>

# Optional HTTPS for local LAN (paths relative to backend/)
# TLS_KEY_PATH=certs/teamora-lan-key.pem
# TLS_CERT_PATH=certs/teamora-lan.pem

# Google OAuth (optional)
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>

# Password-reset email (required in production). Gmail: use an App Password.
# Prefer port 465 (SSL) or 587 (STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-app-password>
# Optional full URL alternative:
# SMTP_URL=smtps://user:pass@smtp.example.com:465
EMAIL_FROM="Teamora <no-reply@example.com>"
# Log reset links instead of SMTP when not configured (dev only):
# EMAIL_DEV_LOG=true

# Optional AI features (if enabled)
# GEMINI_API_KEY=<gemini-api-key>

# --- Ops / reliability (optional) ---
# Graceful shutdown max wait (ms) on SIGTERM
# SHUTDOWN_TIMEOUT_MS=10000
# HTTP server timeouts (ms)
# HTTP_REQUEST_TIMEOUT_MS=120000
# HTTP_HEADERS_TIMEOUT_MS=65000
# HTTP_KEEPALIVE_TIMEOUT_MS=65000
# Mongo connect / pool
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGO_MAX_POOL_SIZE=20
# Exit process on unhandledRejection (default: log only)
# FATAL_ON_UNHANDLED_REJECTION=true
