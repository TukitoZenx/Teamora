NODE_ENV=production
PORT=5000
MONGODB_URI=<mongodb-connection-string>
SESSION_SECRET=<long-random-session-secret>
CLIENT_URL=<frontend-url>
# Required together for HTTPS development (paths are relative to backend/).
# TLS_KEY_PATH=certs/teamora-lan-key.pem
# TLS_CERT_PATH=certs/teamora-lan.pem
SERVER_URL=<backend-url>
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
# Password-reset email (required in production). Gmail: use an App Password.
# Prefer port 465 (SSL) or 587 (STARTTLS). CLIENT_URL must match the public frontend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-app-password>
# Optional full URL alternative:
# SMTP_URL=smtps://user:pass@smtp.example.com:465
EMAIL_FROM="Teamora <no-reply@example.com>"
# EMAIL_DEV_LOG=true

GEMINI_API_KEY=<gemini-api-key>
